# URL base de la API NestJS (backend). No incluyas "/api": se agrega automáticamente.
#
# - Expo web / iOS simulador: http://localhost:3000
# - Emulador Android:          http://10.0.2.2:3000 (auto-detectado si no se define)
# - Dispositivo físico:        http://IP-de-tu-PC:3000 (misma red WiFi)
#
# Si NO defines esta variable, la app usa:
#   - Android emulador -> http://10.0.2.2:3000
#   - resto            -> http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000