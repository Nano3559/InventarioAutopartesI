{
  "expo": {
    "name": "AutoPartes Pro",
    "slug": "autopartes-pro",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autopartes.pro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.autopartes.pro",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "AutoPartes Pro usa la cámara para escanear códigos, fotografiar autopartes y registrar rostros para el control de asistencia.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AutoPartes Pro usa tus fotos para identificar autopartes mediante inteligencia artificial.",
          "cameraPermission": "AutoPartes Pro usa la cámara para escanear códigos, fotografiar autopartes y registrar rostros para el control de asistencia.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1887c51c-74d6-485b-9e27-fba56a42e8a2"
      }
    },
    "owner": "raulez3104"
  }
}
