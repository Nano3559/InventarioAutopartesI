# ============================================================
#  INVENTARIO AUTOPARTES — Variables de entorno (plantilla)
# ------------------------------------------------------------
#  Este archivo es la PLANTILLA segura para subir a GitHub.
#  NO contiene secretos reales.
#
#  USO EN CUALQUIER MAQUINA:
#    El proyecto tiene 3 subproyectos independientes (monorepo).
#    Cada uno lee su propio archivo .env desde su carpeta.
#    Copia esta plantilla a las subcarpetas segun el flujo:
#
#      cp backend\.env.example  backend\.env
#      cp frontend\.env.example frontend\.env.local
#      cp mobile\.env.example   mobile\.env
#
#  Y rellena los valores reales en cada uno.
# ============================================================

# ------------------------------------------------------------
# BACKEND (NestJS) — archivo: backend\.env
# Documentacion original: backend\.env.example
# ------------------------------------------------------------

# Conexion a PostgreSQL (base de datos "AutopartesDB")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AutopartesDB
DB_USER=postgres
DB_PASSWORD=postgres

# Puerto donde corre la API NestJS
PORT=3000

# Clave secreta para firmar los JWT (cambiala en tu .env real)
JWT_SECRET=cambia-esta-clave

# TypeORM: en desarrollo usar true (auto-sincroniza el esquema).
# En produccion poner false y aplicar migraciones controladas.
DB_SYNC=true

# ------------------------------------------------------------
# FRONTEND (React + Vite) — archivo: frontend\.env.local
# Documentacion original: frontend\.env.example
# ------------------------------------------------------------

# URL base de la API NestJS. Incluye "/api".
#   Local:     http://localhost:3000/api
#   Produccion:https://tu-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# Token de Vercel para despliegue (OPCIONAL). Poner el real solo en .env.local.
VERCEL_TOKEN=

# ------------------------------------------------------------
# MOBILE (React Native / Expo) — archivo: mobile\.env
# Documentacion original: mobile\.env.example
# ------------------------------------------------------------

# URL base de la API NestJS. NO incluyas "/api": se agrega automaticamente.
#   - Expo web / iOS simulador: http://localhost:3000
#   - Emulador Android:         http://10.0.2.2:3000
#   - Dispositivo fisico:       http://IP-de-tu-PC:3000 (misma red WiFi)
EXPO_PUBLIC_API_URL=http://localhost:3000
